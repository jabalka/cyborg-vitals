<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp desktop rescap">
  <Identity Name="CyborgVitals" Publisher="CN=CyborgVitals" Version="1.2.0.7" />
  <mp:PhoneIdentity PhoneProductId="0b685afe-097c-44b9-986c-4430ef57f6e0" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>Cyborg Vitals</DisplayName><PublisherDisplayName>Cyborg Vitals</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" /></Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="CyborgVitals.App">
      <uap:VisualElements DisplayName="Cyborg Vitals" Description="CPU, RAM and temperatures in Game Bar"
        Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png" BackgroundColor="transparent">
        <uap:SplashScreen Image="Assets\Splash.png" BackgroundColor="#16181E" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="microsoft.gameBarUIExtension" Id="Vitals"
            DisplayName="Cyborg Vitals" Description="CPU, RAM, GPU and temperatures" PublicFolder="GameBar">
            <uap3:Properties>
              <GameBarWidget Type="Standard">
                <HomeMenuVisible>true</HomeMenuVisible>
                <PinningSupported>true</PinningSupported>
                <Window>
                  <AllowForegroundTransparency>true</AllowForegroundTransparency>
                  <Size><Height>190</Height><Width>230</Width><MinHeight>48</MinHeight><MinWidth>145</MinWidth><MaxHeight>750</MaxHeight><MaxWidth>850</MaxWidth></Size>
                  <ResizeSupported><Horizontal>true</Horizontal><Vertical>true</Vertical></ResizeSupported>
                </Window>
              </GameBarWidget>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="Bridge\CyborgVitals.Launcher.exe"><desktop:FullTrustProcess/></desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust"/><rescap:Capability Name="allowElevation"/></Capabilities>
</Package>
