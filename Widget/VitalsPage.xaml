<Page x:Class="CyborgVitals.VitalsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark" Background="Transparent">
  <Grid Background="Transparent">
    <Grid x:Name="RootPanel" Padding="6,4" VerticalAlignment="Top" Background="Transparent">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border x:Name="Backplate" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="4" Margin="-6,-4"/>
      <StackPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,3" Spacing="1">
        <Button Padding="3,2" Background="Transparent" BorderThickness="0" Click="OpenDiagnostics" ToolTipService.ToolTip="Reading diagnostics" AutomationProperties.Name="Reading diagnostics">
          <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#FFBD59" />
        </Button>
        <Button x:Name="UnitButton" Content="°C" Padding="3,2" FontSize="11" Background="Transparent" BorderThickness="0" Click="ToggleUnits" AutomationProperties.Name="Switch Celsius or Fahrenheit" />
        <Button x:Name="GraphToggle" Content="Graph" Padding="3,2" FontSize="10" Background="Transparent" BorderThickness="0" Click="ToggleGraph" />
        <Button Content="Clear" Padding="3,2" FontSize="10" Background="Transparent" BorderThickness="0" Click="ClearBackground" ToolTipService.ToolTip="Clear the background and use widget opacity" AutomationProperties.Name="Clear background"/>
        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Padding="4,2" FontSize="12" Background="Transparent" BorderThickness="0" Click="OpenSettings" AutomationProperties.Name="Widget settings"/>
      </StackPanel>
      <Grid Grid.Row="1" x:Name="ContentGrid" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
        <ScrollViewer Background="Transparent" x:Name="MetricScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="MetricList" VerticalAlignment="Top" />
        </ScrollViewer>
        <Grid x:Name="GraphArea" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="SelectedTitle" FontSize="10" Foreground="#C6CBD4" VerticalAlignment="Center"/><ContentControl x:Name="SelectedBadgeHost" HorizontalAlignment="Right" HorizontalContentAlignment="Right"/></Grid>
          <Grid Grid.Row="1" MinHeight="40" Margin="0,3,0,0"><Rectangle Stroke="#30404E" StrokeThickness="1"/><Canvas x:Name="Chart" SizeChanged="ChartSizeChanged" Margin="1"/></Grid>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="SettingsContainer" Background="#16181E" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Button Content="&#xE72B;  Back to readings" FontFamily="Segoe UI" Margin="10,6" Padding="10,6" Click="CloseSettings"/>
      <TextBlock x:Name="SettingsErrorBanner" Grid.Row="1" Foreground="#FF8994" TextWrapping="Wrap" Margin="12,4" Visibility="Collapsed"/>
      <Frame x:Name="SettingsFrame" Grid.Row="2" Background="#16181E"/>
    </Grid>
  </Grid>
</Page>
