<Page x:Class="CyborgVitals.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark" Background="#16181E">
  <Grid Padding="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Cyborg Vitals settings" FontSize="20" FontWeight="SemiBold" Margin="6,0,0,8"/>
    <Pivot x:Name="SettingsTabs" Grid.Row="1" SelectionChanged="AlertTabChanged">
      <Pivot.HeaderTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="14"/></DataTemplate></Pivot.HeaderTemplate>
      <PivotItem Header="Display">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Padding="4,4,12,16">
            <ToggleSwitch x:Name="IconsToggle" Header="Show icons" Toggled="IconsChanged"/>
            <ToggleSwitch x:Name="UnitToggle" Header="Temperature unit" OnContent="Fahrenheit (°F)" OffContent="Celsius (°C)" Toggled="UnitsChanged"/>
            <ToggleSwitch x:Name="HostOpacityToggle" Header="Use Game Bar opacity" Toggled="OpacityModeChanged"/>
            <Slider x:Name="OpacitySlider" Header="Background transparency" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OpacityChanged"/>
            <TextBlock x:Name="TransparencyReadout" FontSize="12" TextWrapping="Wrap"/>
            <Button Content="Fully transparent background" Click="ClearBackground"/>
            <ToggleSwitch x:Name="GraphToggle" Header="Show graph" Toggled="GraphChanged"/>
            <TextBlock Text="Graph position" FontWeight="SemiBold"/>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <RadioButton x:Name="LeftPosition" Content="Left" GroupName="Position" Tag="0" Checked="PositionChanged"/>
              <RadioButton x:Name="RightPosition" Content="Right" GroupName="Position" Tag="1" Grid.Column="1" Checked="PositionChanged"/>
              <RadioButton x:Name="TopPosition" Content="Top" GroupName="Position" Tag="2" Grid.Row="1" Checked="PositionChanged"/>
              <RadioButton x:Name="BottomPosition" Content="Bottom" GroupName="Position" Tag="3" Grid.Row="1" Grid.Column="1" Checked="PositionChanged"/>
            </Grid>
            <Button Content="Fit to visible readings" Click="FitClicked"/>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Readings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="4,4,12,16" Spacing="8">
            <TextBlock Text="Visible readings" FontSize="16" FontWeight="SemiBold"/>
            <ToggleSwitch x:Name="AutoStartToggle" Header="Start sensor reader with this widget" Toggled="AutoStartChanged"/>
            <TextBlock Text="Windows may ask for administrator approval when starting the reader. It runs without a tray icon." TextWrapping="Wrap" FontSize="12"/>
            <Button Content="Start sensors / retry" Click="StartSensors"/>
            <ToggleSwitch x:Name="FanProbingToggle" Header="Probe motherboard fan sensors on next reader start" Toggled="FanProbingChanged"/>
            <TextBlock Text="Optional general motherboard probing requires a reader restart. A supported MSI fan fallback is automatic when general RPM readings are missing; it does not require this switch." TextWrapping="Wrap" FontSize="12"/>
            <StackPanel x:Name="VisibilityOptions"/>
            <TextBlock Text="Temperatures and fan RPM need the sensor reader and supported sensors. CPU temp and GPU temp are separate readings." TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Alerts">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="4,4,12,16" Spacing="10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <RepeatButton Content="−" Tag="UsageInput:-" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,4,0" AutomationProperties.Name="Decrease Usage (%)"/>
              <TextBox Grid.Column="1" x:Name="UsageInput" Header="Usage (%)" InputScope="Number" IsReadOnly="False" IsTabStop="True" MaxLength="12" Margin="2,0" GotFocus="ThresholdFocused" LostFocus="ThresholdLostFocus" KeyDown="ThresholdKeyDown"/>
              <RepeatButton Grid.Column="2" Content="+" Tag="UsageInput:+" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="4,0,0,0" AutomationProperties.Name="Increase Usage (%)"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <RepeatButton Content="−" Tag="CpuThresholdInput:-" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,4,0" AutomationProperties.Name="Decrease CPU temperature (°C)"/>
              <TextBox Grid.Column="1" x:Name="CpuThresholdInput" Header="CPU temperature (°C)" InputScope="Number" IsReadOnly="False" IsTabStop="True" MaxLength="12" Margin="2,0" GotFocus="ThresholdFocused" LostFocus="ThresholdLostFocus" KeyDown="ThresholdKeyDown"/>
              <RepeatButton Grid.Column="2" Content="+" Tag="CpuThresholdInput:+" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="4,0,0,0" AutomationProperties.Name="Increase CPU temperature (°C)"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <RepeatButton Content="−" Tag="GpuThresholdInput:-" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,4,0" AutomationProperties.Name="Decrease GPU temperature (°C)"/>
              <TextBox Grid.Column="1" x:Name="GpuThresholdInput" Header="GPU temperature (°C)" InputScope="Number" IsReadOnly="False" IsTabStop="True" MaxLength="12" Margin="2,0" GotFocus="ThresholdFocused" LostFocus="ThresholdLostFocus" KeyDown="ThresholdKeyDown"/>
              <RepeatButton Grid.Column="2" Content="+" Tag="GpuThresholdInput:+" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="4,0,0,0" AutomationProperties.Name="Increase GPU temperature (°C)"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <RepeatButton Content="−" Tag="FanThresholdInput:-" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,4,0" AutomationProperties.Name="Decrease Fan speed (RPM)"/>
              <TextBox Grid.Column="1" x:Name="FanThresholdInput" Header="Fan speed (RPM)" InputScope="Number" IsReadOnly="False" IsTabStop="True" MaxLength="12" Margin="2,0" GotFocus="ThresholdFocused" LostFocus="ThresholdLostFocus" KeyDown="ThresholdKeyDown"/>
              <RepeatButton Grid.Column="2" Content="+" Tag="FanThresholdInput:+" Click="AdjustThreshold" Delay="400" Interval="70" ClickMode="Press" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="4,0,0,0" AutomationProperties.Name="Increase Fan speed (RPM)"/>
            </Grid>
            <ToggleSwitch x:Name="BlinkToggle" Header="Blink alert dots" Toggled="BlinkChanged"/>
            <TextBlock Text="Click ± for one step; hold to repeat. Type a value and press Enter or leave the field to save. Fan steps are 100 RPM. Attention thresholds, not hardware danger limits. High fan RPM can be normal." TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="SettingsError" Foreground="#FF8994" TextWrapping="Wrap" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save thresholds" Click="SaveAlerts"/><Button Content="Defaults" Click="ResetAlerts"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Status">
        <Grid Padding="4">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Keep the monitoring widget visible to receive live status." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
          <TextBox Grid.Row="1" x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
